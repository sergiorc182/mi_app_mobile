# Cotización USD a ARS
USD_A_ARS_COTIZACION=1250

# Firebase (para el bot y los scripts de siembra)
FIREBASE_API_KEY=tu_api_key_de_firebase_web
FIREBASE_PROJECT_ID=mi-app-mobile-8fd75
FIREBASE_ADMIN_EMAIL=cuenta_admin_para_lectura
