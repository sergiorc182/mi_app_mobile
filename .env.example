# Groq AI
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODELO=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=500

# Telegram Bot (de @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram

# Mercado Pago Checkout Pro
