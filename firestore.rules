rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el usuario dueño puede leer/escribir su propio documento
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Subcolección de conversaciones del usuario
      match /conversaciones/{conversacionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Subcolección de mensajes de cada conversación
        match /mensajes/{mensajeId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
